---
// 404 Fallback redirect page
const TARGET_URL = "https://mehedi-hasan.me/";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Redirecting to mehedi-hasan.me...</title>
		<meta http-equiv="refresh" content={`0; url=${TARGET_URL}`} />
		<link rel="canonical" href={TARGET_URL} />
		<meta name="robots" content="noindex, follow" />
		<script is:inline define:vars={{ TARGET_URL }}>
			window.location.replace(TARGET_URL);
		</script>
	</head>
	<body>
		<main class="container">
			<div class="card">
				<div class="spinner"></div>
				<h1>Redirecting...</h1>
				<p>Taking you to <span class="url">mehedi-hasan.me</span></p>
				<p class="subtext">
					If you are not redirected automatically within a few seconds,
					<br />
					<a href={TARGET_URL} class="link">click here to proceed</a>.
				</p>
			</div>
		</main>

		<style>
			:root {
				--bg: #090d16;
				--card-bg: rgba(255, 255, 255, 0.04);
				--border: rgba(255, 255, 255, 0.08);
				--text-primary: #f8fafc;
				--text-secondary: #94a3b8;
				--accent: #38bdf8;
				--accent-hover: #7dd3fc;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
				background-color: var(--bg);
				color: var(--text-primary);
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 1.5rem;
			}

			.container {
				width: 100%;
				max-width: 440px;
			}

			.card {
				background: var(--card-bg);
				border: 1px solid var(--border);
				border-radius: 16px;
				padding: 2.5rem 2rem;
				text-align: center;
				backdrop-filter: blur(12px);
				box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
			}

			.spinner {
				width: 44px;
				height: 44px;
				margin: 0 auto 1.5rem;
				border: 3px solid rgba(56, 189, 248, 0.15);
				border-top-color: var(--accent);
				border-radius: 50%;
				animation: spin 0.8s cubic-bezier(0.5, 0.1, 0.5, 0.9) infinite;
			}

			h1 {
				font-size: 1.4rem;
				font-weight: 600;
				letter-spacing: -0.02em;
				margin-bottom: 0.5rem;
			}

			p {
				color: var(--text-secondary);
				font-size: 0.95rem;
				line-height: 1.5;
			}

			.url {
				color: var(--accent);
				font-weight: 500;
			}

			.subtext {
				margin-top: 1.25rem;
				font-size: 0.85rem;
			}

			.link {
				color: var(--accent);
				text-decoration: underline;
				text-underline-offset: 3px;
				transition: color 0.2s ease;
				display: inline-block;
				margin-top: 0.4rem;
			}

			.link:hover {
				color: var(--accent-hover);
			}

			@keyframes spin {
				to {
					transform: rotate(360deg);
				}
			}
		</style>
	</body>
</html>
